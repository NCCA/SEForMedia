# Inference image for the spiral classifier.
#
# Build with
#   podman build -t localhost/spiral-serve:0.1 -f Containerfile.serve .
#
# This image has no torch in it at all, just onnxruntime and a web server, so it
# is a fraction of the size of the training image and starts quickly.

ARG BASE_IMAGE=docker.io/library/python:3.12-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.32

FROM ${UV_IMAGE} AS uv
FROM ${BASE_IMAGE}

COPY --from=uv /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    UV_SYSTEM_PYTHON=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    MODEL_DIR=/models

WORKDIR /app
COPY requirements-serve.txt .
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install -r requirements-serve.txt
COPY serve.py .

# don't run a public facing service as root, the model is mounted read only so
# this user never needs to write anything
RUN useradd --create-home --uid 1000 app
USER app

EXPOSE 8080
CMD ["uvicorn", "serve:app", "--host", "0.0.0.0", "--port", "8080"]
