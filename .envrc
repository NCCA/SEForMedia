export VIRTUAL_ENV=$PWD/.venv

# Linux (the lab machines) stays on 3.13, macOS can use 3.14. UV_PYTHON
# overrides any local .python-version.
if [[ "$(uname -s)" == "Darwin" ]]; then
    export UV_PYTHON=3.14
else
    export UV_PYTHON=3.13
fi

if [[ ! -d $VIRTUAL_ENV ]]; then
    uv sync
fi

PATH_add "$VIRTUAL_ENV/bin"
export VIRTUAL_ENV_PROMPT="($(basename $PWD)) "

# Tell Zsh to source this file
export DIRENV_ZSH_HOOK="$PWD/zsh_functions.sh"
